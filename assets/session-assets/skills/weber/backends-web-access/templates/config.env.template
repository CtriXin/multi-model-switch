# web-access skill 用户偏好配置
# 此文件是模板。首次运行 check-deps.mjs 时会自动复制为 config.env（git ignored）。
#
# MMF/Codex 隔离会话可填写宿主用户 Home；留空则使用当前进程 HOME。
# 优先级：WEB_ACCESS_HOST_HOME 环境变量 > HOST_HOME > REAL_HOME > 此项。
WEB_ACCESS_HOST_HOME=

# 用户长期偏好的默认 Agent 浏览器
# - 留空：每次启动都问用户偏好哪个
# - 设值：固定使用该浏览器；若未检测到对应 toggle 则硬错（不擅自降级）
#
# 合法值：chrome / edge
WEB_ACCESS_BROWSER=
