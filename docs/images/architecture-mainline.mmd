flowchart LR
  subgraph Entry[Entry Surfaces]
    E1["Install & Packs\n`install.sh` bootstraps MMS itself and optional packs like RTK, MindKeeper context, Map, read-once, and ops-env-safe."]
    E2["TUI & CLI\n`mms`, `mms claude`, `mms codex`, `mmc`, and related commands expose one local launcher surface."]
    E3["Web / Runtime API\nWorkspace apps under `apps/web` and `apps/runtime-api` offer an additional operator and integration surface."]
  end
  subgraph Runtime[Core Runtime / Workflow]
    R1["Load Config & State\nRead `config.toml`, overrides, accounts, env files, usage, and gateway session context from the real MMS config tree."]
    R2["Resolve Adapters\nMap model families, CLI capabilities, and provider/account metadata through the adapter registry and family rules."]
    R3["Route & Classify\nCombine keyword guardrails, LLM classification, sticky escalation, role, and priority to choose the right provider or lane."]
    R4["Launch or Bridge\nSpawn isolated Claude/Codex sessions, gateway bridges, or API-facing flows with the resolved env and route selection."]
    R5["Export & Diagnose\nWrite route exports, usage, speed stats, and diagnostics so operators can inspect what MMS will actually do next."]
  end
  subgraph Artifacts[Artifacts / Operator Surfaces]
    A1["Config Tree\n`~/.config/mms/` holds `config.toml`, `override.toml`, `accounts/`, `env/`, and usage/session state."]
    A2["Routing Artifacts\n`model-routes.json`, route keyword files, gateway slots, and speed stats expose the current runtime picture."]
    A3["Operator Surfaces\n`mms routes`, `doctor`, `test`, `warm`, and the TUI let the operator steer or debug the system."]
  end
  E1 --> R1
  E2 --> R1
  E3 --> R1
  R1 --> R2
  R2 --> R3
  R3 --> R4
  R4 --> R5
  R5 --> A1
  R5 --> A2
  R5 --> A3
