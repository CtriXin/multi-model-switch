          "api-key",
          "authorization_bearer"
        ],
        "anthropic_messages": [
          "api-key",
          "authorization_bearer"
        ]
      },
      "thinking": {
        "supported": true,
        "ui": "thinking_toggle",
        "default_enabled": true,
        "roundtrip": "anthropic_thinking_blocks"
      },
      "body_patches": {
        "openai_chat": {
          "thinking_on": {
            "thinking.type": "enabled"
          },
          "thinking_off": {
            "thinking.type": "disabled"
          },
          "classify": {
            "thinking.type": "disabled"
          }
        },
        "anthropic_messages": {
          "thinking_on": {
            "thinking.type": "enabled"
          },
          "thinking_off": {
            "thinking.type": "disabled"
          },
          "classify": {
            "thinking.type": "disabled"
          }
        }
      },
      "context_windows": {
        "mimo-v2.5-pro": 1000000,
        "mimo-v2.5": 1000000,
        "mimo-v2-pro": 1000000,
        "mimo-v2-omni": 262144,
        "mimo-v2-flash": 262144
      },
      "api_formats": {
        "openai_chat": {
          "base_url": "https://api.xiaomimimo.com/v1",
          "request_path": "/chat/completions"
        },
        "anthropic_messages": {
          "base_url": "https://api.xiaomimimo.com/anthropic",
          "request_path": "/v1/messages"
        },
        "token_plan_openai_chat": {
          "base_url": "https://token-plan-cn.xiaomimimo.com/v1",
          "request_path": "/chat/completions"
        },
        "token_plan_anthropic_messages": {
          "base_url": "https://token-plan-cn.xiaomimimo.com/anthropic",
          "request_path": "/v1/messages"
        }
      }
    },
    "minimax": {
