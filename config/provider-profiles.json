{
  "schema_version": 1,
  "description": "MMS provider/model profile references. This file is declarative data only: endpoints, docs, auth headers, thinking/body patch rules, and context metadata.",
  "profiles": {
    "openai": {
      "label": "OpenAI GPT",
      "match": {
        "provider_id_contains": [
          "openai"
        ],
        "base_url_contains": [
          "api.openai.com"
        ],
        "model_prefixes": [
          "gpt-",
          "o1",
          "o3",
          "o4",
          "codex-"
        ]
      },
      "references": [
        "https://platform.openai.com/docs/api-reference/responses",
        "https://platform.openai.com/docs/guides/reasoning",
        "https://platform.openai.com/docs/models"
      ],
      "endpoints": {
        "openai_base_url": "https://api.openai.com/v1",
        "anthropic_base_url": ""
      },
      "auth_headers": {
        "responses": [
          "authorization_bearer"
        ],
        "openai_chat": [
          "authorization_bearer"
        ]
      },
      "thinking": {
        "supported": true,
        "ui": "thinking_and_effort",
        "default_enabled": true,
        "roundtrip": "responses_items"
      },
      "effort": {
        "responses": {
          "path": "reasoning.effort",
          "default": "medium",
          "allowed": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        }
      },
      "model_overrides": {
        "gpt-5.1": {
          "effort": {
            "responses": {
              "default": "none",
              "allowed": [
                "none",
                "low",
                "medium",
                "high"
              ]
            }
          }
        },
        "gpt-5-pro": {
          "effort": {
            "responses": {
              "default": "high",
              "allowed": [
                "high"
              ]
            }
          }
        }
      },
      "context_windows": {
        "gpt-5": 1000000,
        "gpt-5.4": 1000000,
        "gpt-5.4-mini": 1000000,
        "gpt-5.5": 1000000,
        "gpt-5-pro": 1000000
      },
      "api_formats": {
        "responses": {
          "base_url": "https://api.openai.com/v1",
          "request_path": "/responses"
        }
      },
      "body_patches": {
        "responses": {
          "thinking_off": {
            "reasoning": "__delete__"
          }
        }
      }
    },
    "dashscope-openai": {
      "label": "Alibaba DashScope OpenAI-compatible",
      "match": {
        "provider_id_contains": [
          "qwen",
          "dashscope",
          "bailian"
        ],
        "base_url_contains": [
          "dashscope.aliyuncs.com"
        ]
      },
      "references": [
        "https://help.aliyun.com/zh/model-studio/deep-thinking",
        "https://help.aliyun.com/zh/model-studio/compatibility-with-openai-responses-api"
      ],
      "endpoints": {
        "openai_base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "anthropic_base_url": "https://dashscope.aliyuncs.com/apps/anthropic"
      },
      "auth_headers": {
        "openai_chat": [
          "authorization_bearer"
        ],
        "anthropic_messages": [
          "authorization_bearer",
          "x-api-key"
        ]
      },
      "thinking": {
        "supported": true,
        "ui": "thinking_toggle",
        "default_enabled": null,
        "roundtrip": "openai_reasoning_content"
      },
      "body_patches": {
        "openai_chat": {
          "thinking_on": {
            "enable_thinking": true
          },
          "thinking_off": {
            "enable_thinking": false
          },
          "classify": {
            "enable_thinking": false
          }
        },
        "anthropic_messages": {
          "thinking_on": {
            "thinking.type": "enabled"
          },
          "thinking_off": {
            "thinking.type": "disabled"
          },
          "classify": {
            "thinking.type": "disabled"
          }
        }
      },
      "budget": {
        "openai_chat": {
          "path": "thinking_budget"
        }
      },
      "model_overrides": {
        "qwen3.6": {
          "thinking": {
            "default_enabled": true
          }
        },
        "qwen3.5": {
          "thinking": {
            "default_enabled": true
          }
        },
        "qwen3-max": {
          "thinking": {
            "default_enabled": false
          }
        },
        "qwen-plus": {
          "thinking": {
            "default_enabled": false
          }
        },
        "qwen-turbo": {
          "thinking": {
            "default_enabled": false
          }
        },
        "qwq": {
          "thinking": {
            "mode": "always_on"
          }
        }
      },
      "api_formats": {
        "openai_chat": {
          "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
          "request_path": "/chat/completions"
        },
        "anthropic_messages": {
          "base_url": "https://dashscope.aliyuncs.com/apps/anthropic",
          "request_path": "/v1/messages"
        }
      }
    },
    "qwen-chat-template": {
      "label": "Qwen local/chat-template compatible",
      "match": {
        "profile_only": true,
        "model_prefixes": [
          "qwen"
        ]
      },
      "references": [
        "https://help.aliyun.com/zh/model-studio/deep-thinking"
      ],
      "auth_headers": {
        "openai_chat": [
          "authorization_bearer"
        ]
      },
      "thinking": {
        "supported": true,
        "ui": "thinking_toggle",
        "default_enabled": true,
        "roundtrip": "openai_reasoning_content"
      },
      "body_patches": {
        "openai_chat": {
          "thinking_on": {
            "chat_template_kwargs.enable_thinking": true
          },
          "thinking_off": {
            "chat_template_kwargs.enable_thinking": false
          },
          "classify": {
            "chat_template_kwargs.enable_thinking": false
          }
        }
      },
      "api_formats": {
        "openai_chat": {
          "base_url": "<local-or-compatible>/v1",
          "request_path": "/chat/completions"
        }
      }
    },
