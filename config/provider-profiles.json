        "anthropic_messages": {
          "base_url": "https://api.minimaxi.com/anthropic",
          "request_path": "/v1/messages"
        },
        "openai_chat_global": {
          "base_url": "https://api.minimax.io/v1",
          "request_path": "/chat/completions"
        },
        "anthropic_messages_global": {
          "base_url": "https://api.minimax.io/anthropic",
          "request_path": "/v1/messages"
        }
      }
