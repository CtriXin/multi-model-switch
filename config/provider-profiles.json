        "minimax-m2.7-highspeed": 204800,
        "minimax-m2.5": 204800,
        "minimax-m2.5-highspeed": 204800,
        "minimax-m2.1": 204800,
        "minimax-m2.1-highspeed": 204800,
        "minimax-m2": 204800
      },
      "api_formats": {
